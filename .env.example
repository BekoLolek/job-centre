# Copy to .env.local for local dev, and set the same keys in Vercel for production.

# Signs the login cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin (you). No balance, but every control.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Read-only spectator. Sees the wheel, balances and who has bid — never the amounts,
# except the winning bid once a lot is settled.
OBSERVER_USERNAME=observer
OBSERVER_PASSWORD=change-me

# The four captains. The username IS the captain's name: their team shows up
# everywhere as "Team <username>", so pick the login accordingly.
CAPTAIN1_USERNAME=captain1
CAPTAIN1_PASSWORD=change-me

CAPTAIN2_USERNAME=captain2
CAPTAIN2_PASSWORD=change-me

CAPTAIN3_USERNAME=captain3
CAPTAIN3_PASSWORD=change-me

CAPTAIN4_USERNAME=captain4
CAPTAIN4_PASSWORD=change-me

# Starting balance handed to each captain on a fresh draft (editable in the admin UI).
DEFAULT_BALANCE=1000

# Storage. Leave both unset for local dev (state lands in ./data/draft.json).
# On Vercel, adding the Upstash for Redis integration injects KV_REST_API_URL / KV_REST_API_TOKEN
# automatically — no code changes needed.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=


# ============================================================================
# Job Centre Events platform (Phase 1 onwards) — placeholders until provisioned
# ============================================================================

# Postgres. LEAVE THIS BLANK for local development: with no DATABASE_URL the app
# runs on PGlite — real Postgres 17 compiled to WASM — persisted in ./data/pg,
# so nothing external is needed to run migrations, the seed or the tests.
#
# Set it to switch to Neon and nothing else changes. Neon free tier:
# https://neon.tech — create a project, then a "dev" branch so local work never
# touches live data. Vercel's Storage tab provisions the same thing and injects
# this variable into deployments automatically.
#
#   npm run db:migrate   apply ./drizzle to whichever of the two is selected
#   npm run db:seed      games, profile fields and the guild-gate settings
#   npm run db:generate  regenerate ./drizzle after editing src/db/schema.ts
#   npm run db:studio    browse the data
DATABASE_URL=

# Discord OAuth — https://discord.com/developers/applications
# OAuth2 tab: copy the client id, then "Reset Secret" for the secret. Register
# these redirect URIs: http://localhost:3400/api/auth/callback/discord and the
# production equivalent.
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me

# Sign-in is gated to members of this guild. In Discord enable Developer Mode
# (Settings -> Advanced), then right-click the server -> Copy Server ID.
# The gate and the guild are also editable in admin once the settings table exists.
DISCORD_GUILD_ID=000000000000000000

# Seeds the first admin(s) before there is an admin UI to grant the flag.
# Right-click your own name in Discord -> Copy User ID. Comma-separated.
ADMIN_DISCORD_IDS=000000000000000000

# Signs Auth.js session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me

# Base URL Auth.js builds callback links from. Local only — on Vercel, Auth.js
# derives it from the deployment host, so leave it UNSET there. Setting it to the
# wrong host is the usual cause of a broken OAuth callback.
AUTH_URL=http://localhost:3400

# Optional: Discord webhook for event announcements and results (Phase 5).
# DISCORD_WEBHOOK_URL=


# ============================================================================
# DEVELOPMENT SIGN-IN — READ THIS BEFORE SWITCHING IT ON
# ============================================================================
#
# WARNING: DEV_LOGIN=1 turns /dev-login into a page whose button signs anyone
# who presses it in as a real member, with no password and no Discord. Anybody
# who can reach the server can become that user — and an admin, if
# DEV_LOGIN_ADMIN=1. It exists for one reason: the Discord application does not
# exist yet, so without it the member and admin pages cannot be opened at all.
#
# It CANNOT be reached from a deployment. The page requires BOTH
# NODE_ENV=development AND DEV_LOGIN switched on, and `next build` / `next start`
# — which is what Vercel runs — always set NODE_ENV=production. Setting
# DEV_LOGIN=1 in the Vercel dashboard by mistake therefore does nothing. Every
# page shows an unmissable banner while a development session is live.
#
# Turn it off (or delete these three lines) the moment Discord sign-in works.
DEV_LOGIN=1

# Which "Discord id" the development user is keyed on. Leave blank for the
# built-in obviously-fake id, which cannot collide with a real snowflake.
DEV_LOGIN_DISCORD_ID=

# 1 to make the development user an admin, so /admin/games can be opened.
# Flipping it back to 0 and signing in again really does drop the flag, which is
# how you test that requireAdmin() turns a member away.
DEV_LOGIN_ADMIN=1
