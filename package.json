{
  "name": "tournament-draft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs src/db/seed.ts",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.5",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
